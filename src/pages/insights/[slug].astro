---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const entries = await getCollection('insights');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

type Props = CollectionEntry<'insights'>;

const entry = Astro.props;
const { Content } = await entry.render();
---
<Layout 
  title={entry.data.title}
  description={entry.data.description}
>
  <NavBar />
  <main class="py-16 sm:py-24 bg-primary">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-8 sm:mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-space font-bold text-text mb-4 sm:mb-6 tracking-tight">
          {entry.data.title}
        </h1>
        <div class="flex items-center space-x-4 text-text-muted">
          <div class="flex items-center space-x-3">
            {entry.data.authorImage && (
              <Image 
                src={entry.data.authorImage} 
                alt={entry.data.author || 'Author'}
                width={40}
                height={40}
                class="rounded-full"
              />
            )}
            <div class="text-sm sm:text-base">
              <p class="font-medium text-text">{entry.data.author}</p>
              {entry.data.authorTwitter && (
                <a href={`https://twitter.com/${entry.data.authorTwitter}`} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                  @{entry.data.authorTwitter}
                </a>
              )}
            </div>
          </div>

        </div>
      </header>
      <div class="prose prose-lg sm:prose-xl max-w-none prose-headings:font-space prose-headings:font-bold prose-a:text-accent hover:prose-a:text-accent-dark prose-img:rounded-lg prose-invert">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>