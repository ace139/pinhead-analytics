---
import { Image } from 'astro:assets';

export interface Props {
  industry: string;
  title: string;
  description: string;
  stackIcons: string[]; // Will be used for 'Services Used' pills
  link: string;
  // imageUrl?: string; // No longer used
  // keyBenefits?: string[]; // No longer used
}

const { 
  industry,
  title,
  description,
  stackIcons = [],
  link
  // imageUrl, // No longer used
  // keyBenefits // No longer used
} = Astro.props;
---

<div class="bg-white rounded-2xl shadow-lg p-6 flex flex-col h-full transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
  <!-- Top Bar: Industry Pill and Icon -->
  <div class="flex justify-between items-start mb-4">
    <span class="inline-flex items-center px-4 py-1.5 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
      {industry}
    </span>
    {/* Top-right icon removed as per user request */}
  </div>

  <!-- Main Content -->
  <div class="flex-grow">
    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">
      {title}
    </h3>
    <p class="text-xs text-gray-500 uppercase font-semibold mb-3">
      {industry}
    </p>
    <p class="text-gray-600 text-sm mb-4 leading-relaxed  min-h-[3.5rem]">
      {description}
    </p>

    <!-- Services Used -->
    {stackIcons && stackIcons.length > 0 && (
      <div class="mb-4">
        <h4 class="text-sm font-semibold text-gray-800 mb-2">Services Used:</h4>
        <div class="flex flex-wrap gap-2">
          {stackIcons.map(service => (
            <span class="inline-flex items-center px-3 py-1 bg-pink-100 text-pink-700 text-xs font-medium rounded-full">
              {service}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Footer: Read More Link -->
  <div class="mt-auto pt-4">
    <a
      href={link}
      class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors duration-300 font-medium text-sm group"
    >
      <span class="mr-1">Read More</span>
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</div>